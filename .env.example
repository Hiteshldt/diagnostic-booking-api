# Copy to .env and export, or pass these through docker-compose.
# Every value has a working default for local development.

SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
DEBUG=true
ALLOWED_HOSTS=*

# Leave unset to use a local SQLite file.
DATABASE_URL=postgres://eve:eve@localhost:5432/eve

# Leave unset to use an in-process cache and run Celery tasks inline.
REDIS_URL=redis://localhost:6379/0

# Shared secret used to sign and verify payment webhooks (HMAC-SHA256).
WEBHOOK_SECRET=dev-webhook-secret

# Chance that a simulated payment succeeds when the caller does not force an outcome.
PAYMENT_SUCCESS_RATE=0.8
